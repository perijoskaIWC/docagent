<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Local overrides without touching committed files, e.g. flipping your own fake flag:
         dotnet user-secrets set "Features:Fakes:Chat" "false" -p src/DocAgent.Api -->
    <UserSecretsId>007ee59b-27ce-4a0f-84a2-f3ed86b1163c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocAgent.Core\DocAgent.Core.csproj" />
    <ProjectReference Include="..\DocAgent.Fakes\DocAgent.Fakes.csproj" />
    <ProjectReference Include="..\DocAgent.Profiling\DocAgent.Profiling.csproj" />
    <ProjectReference Include="..\DocAgent.Agents\DocAgent.Agents.csproj" />
    <ProjectReference Include="..\DocAgent.Knowledge\DocAgent.Knowledge.csproj" />
    <ProjectReference Include="..\DocAgent.Safety\DocAgent.Safety.csproj" />
    <ProjectReference Include="..\DocAgent.Infrastructure\DocAgent.Infrastructure.csproj" />
    <ProjectReference Include="..\DocAgent.ServiceDefaults\DocAgent.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The upload rules are internal; the unit tests check them directly. -->
    <InternalsVisibleTo Include="DocAgent.UnitTests" />
  </ItemGroup>

</Project>
